OCR_MODEL=qwen3-vl:8b-instruct
OLLAMA_URL=http://localhost:11434
OCR_MAX_EDGE=1400
OCR_KEEP_ALIVE=30m
OCR_SESSION_TTL_S=900
OCR_TMP_DIR=./tmp/ocr
OCR_REVIEW_THRESHOLD=0.7
# OCR_FALLBACK=tesseract   # legacy engine; not present in this repo, flag is reserved
OCR_USERS_FILE=./data/users.json   # created by scripts/create_user.py, never committed
OCR_AUTH_IDLE_S=900
OCR_MAX_LOGIN_FAILURES=5
OCR_LOCKOUT_S=60
INTAKE_DATA_DIR=./data_local
INTAKE_LLM_MODEL=qwen3:8b
# --- offline proof / demo ---
OFFLINE_STRICT=0                 # 1 = any non-localhost connection raises and is logged
OFFLINE_PROBE_HOST=1.1.1.1       # public host for the "is the internet reachable" badge check (never used by the app)
OFFLINE_PROBE_PORT=443
OFFLINE_PROBE_TIMEOUT_S=2
OFFLINE_CHECK_INTERVAL_S=30
DEMO_MODE=0                      # 1 = show "Load demo patient" on the Dosage check page; dosing results carry the red DEMO banner
# --- patient identity (kiosk step 1) ---
IDENTITY_MASTER_KEY=              # urlsafe base64, 32+ bytes. Empty = a key file is created at <INTAKE_DATA_DIR>/identity.key (gitignored, never commit). Losing it makes stored identifiers unreadable.
IDENTITY_SESSION_IDLE_S=900       # kiosk identity token expires after this much idle time
IDENTITY_DEVICE_RATE=30           # max identify/login attempts per kiosk device per 5 minutes
KIOSK_SCAN_KEEP_IMAGE=1           # 1 = keep the original scan image after the patient confirms the text (doctor can view); 0 = delete it
KIOSK_ID=kiosk-1                  # recorded in each consent record
